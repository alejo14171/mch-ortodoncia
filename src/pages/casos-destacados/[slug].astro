---
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import type { ImageMetadata } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/nav/Header.astro";
import Footer from "../../components/nav/Footer.astro";
import Eyebrow from "../../components/ui/Eyebrow.astro";
import Button from "../../components/ui/Button.astro";

export async function getStaticPaths() {
  const featured = await getCollection("featuredCases");
  return featured
    .filter((c) => c.data.published)
    .map((c) => ({ params: { slug: c.data.slug }, props: { entry: c } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const photos = import.meta.glob<ImageMetadata>(
  "../../assets/casos-destacados/**/*.jpg",
  { eager: true, import: "default" }
);
function findPhoto(dir: string, phase: "antes" | "despues", key: string): ImageMetadata | null {
  const target = `casos-destacados/${dir}/${phase}/${key}.jpg`;
  const e = Object.entries(photos).find(([k]) => k.includes(target));
  return e ? e[1] : null;
}

const pairs = entry.data.pairs.map((p) => ({
  ...p,
  antes: findPhoto(entry.data.photos_dir, "antes", p.key),
  despues: findPhoto(entry.data.photos_dir, "despues", p.key),
}));

const heroAntes = findPhoto(entry.data.photos_dir, "antes", entry.data.hero_pair);
const heroDespues = findPhoto(entry.data.photos_dir, "despues", entry.data.hero_pair);

const title = `${entry.data.patient} — Caso destacado · MCH Ortodoncia`;
const description = entry.data.summary;
---

<BaseLayout title={title} description={description} canonical={`/casos-destacados/${entry.data.slug}`}>
  <Header />
  <main>
    <!-- ────────── HERO ────────── -->
    <section class="pt-12 md:pt-16 pb-14 md:pb-20 bg-bone">
      <div class="container-page max-w-6xl">
        <nav class="text-[12px] text-slate-warm mb-7" aria-label="Breadcrumb">
          <a href="/" class="hover:text-champagne-deep">Inicio</a>
          <span class="opacity-50 mx-2">/</span>
          <a href="/casos-destacados" class="hover:text-champagne-deep">Casos destacados</a>
          <span class="opacity-50 mx-2">/</span>
          <span class="text-ink">{entry.data.patient}</span>
        </nav>

        <div class="grid lg:grid-cols-[1.4fr_1fr] gap-10 lg:gap-16 items-start">
          <div class="max-w-2xl">
            <Eyebrow class="mb-5">CASO DESTACADO · SIN CIRUGÍA</Eyebrow>
            <h1 class="font-display text-[clamp(34px,4.6vw,56px)] leading-[1.04] mb-2">
              {entry.data.patient}
            </h1>
            <p class="text-[14px] tracking-[0.04em] text-champagne-deep uppercase mb-7">
              {entry.data.age_at_start}–{entry.data.age_at_end} años · {entry.data.duration_months} meses · 0 cirugías
            </p>
            <p class="text-[17px] text-ink-soft leading-[1.7] mb-8">
              {entry.data.summary}
            </p>

            <!-- Compact ficha -->
            <dl class="grid sm:grid-cols-2 gap-x-8 gap-y-5 text-[13px] pb-8 mb-7 border-b border-line">
              <div>
                <dt class="eyebrow text-[10px] mb-1.5">Diagnóstico</dt>
                <dd class="text-ink-soft leading-snug">{entry.data.diagnosis}</dd>
              </div>
              <div>
                <dt class="eyebrow text-[10px] mb-1.5">Tratamiento</dt>
                <dd class="text-ink-soft leading-snug">{entry.data.treatment}</dd>
              </div>
            </dl>

            <!-- Privacy + consent attestation -->
            <div class="bg-bone-soft border border-line rounded-xl p-5 max-w-prose">
              <div class="flex items-start gap-3">
                <span class="flex-shrink-0 w-6 h-6 rounded-full bg-success/15 border border-success/40 flex items-center justify-center text-success text-[12px] font-semibold mt-0.5">
                  ✓
                </span>
                <div class="text-[12px] text-ink-soft leading-[1.6]">
                  <strong class="text-ink">Publicado con consentimiento.</strong>
                  Existe consentimiento informado del paciente y de su representante legal (Ley 1581 de 2012). La identidad se protege con difuminado de la región ocular.
                </div>
              </div>
            </div>
          </div>

          <!-- Compact hero pair (right column) -->
          {heroAntes && heroDespues && (
            <aside class="lg:sticky lg:top-24">
              <div class="grid grid-cols-2 gap-1.5 rounded-2xl overflow-hidden shadow-[0_25px_60px_-20px_rgba(26,34,56,0.25)] max-w-[420px] mx-auto">
                <figure class="relative aspect-[3/4] bg-bone-soft">
                  <Image
                    src={heroAntes}
                    alt={`Antes — ${entry.data.diagnosis} (paciente con identidad anonimizada)`}
                    widths={[300, 450, 600]}
                    sizes="(min-width: 1024px) 210px, 45vw"
                    loading="eager"
                    decoding="sync"
                    fetchpriority="high"
                    format="webp"
                    quality={86}
                    class="w-full h-full object-cover"
                  />
                  <span class="absolute top-2 left-2 inline-flex items-center px-2 py-0.5 rounded-full bg-ink/90 text-bone text-[9px] font-medium tracking-[0.2em] uppercase backdrop-blur-md">
                    Antes
                  </span>
                </figure>
                <figure class="relative aspect-[3/4] bg-bone-soft">
                  <Image
                    src={heroDespues}
                    alt={`Después — armonía oclusal restablecida (paciente con identidad anonimizada)`}
                    widths={[300, 450, 600]}
                    sizes="(min-width: 1024px) 210px, 45vw"
                    loading="eager"
                    decoding="sync"
                    fetchpriority="high"
                    format="webp"
                    quality={86}
                    class="w-full h-full object-cover"
                  />
                  <span class="absolute top-2 left-2 inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-success/95 text-bone text-[9px] font-medium tracking-[0.2em] uppercase backdrop-blur-md">
                    <span class="w-1 h-1 rounded-full bg-champagne"></span>
                    Después
                  </span>
                </figure>
              </div>
              <p class="mt-3 text-[11px] text-slate-warm text-center tracking-wide">
                Vista de {entry.data.hero_pair} · antes y después
              </p>
            </aside>
          )}
        </div>
      </div>
    </section>

    <!-- ────────── EDITORIAL: pair-by-pair ────────── -->
    <section class="bg-bone-soft border-y border-line">
      <div class="container-page max-w-5xl py-16 md:py-24">
        <header class="mb-14 md:mb-20 max-w-2xl">
          <Eyebrow class="mb-4">REGISTRO CLÍNICO</Eyebrow>
          <h2 class="font-display text-[clamp(26px,3.4vw,38px)] leading-[1.1]">
            El cambio, vista por vista.
          </h2>
          <p class="text-[15px] text-ink-soft leading-[1.65] mt-4 max-w-prose">
            Cada par documenta la misma vista clínica antes y al final del tratamiento. Las fotografías no llevan retoque digital — solo el difuminado de la región ocular para preservar la identidad del paciente.
          </p>
        </header>

        <div class="space-y-20 md:space-y-28">
          {pairs.map((p, i) => {
            if (!p.antes || !p.despues) return null;
            const textRight = i % 2 === 1;
            const num = String(i + 1).padStart(2, "0");
            return (
              <article class="grid md:grid-cols-12 gap-8 md:gap-12 items-center">
                <!-- Text column -->
                <div class:list={[
                  "md:col-span-5",
                  textRight ? "md:order-2 md:col-start-8" : "md:order-1",
                ]}>
                  <div class="flex items-baseline gap-3 mb-3">
                    <span class="font-display text-[28px] text-champagne-deep leading-none">{num}</span>
                    <span class="text-[10px] tracking-[0.22em] uppercase text-slate-warm">
                      Vista clínica
                    </span>
                  </div>
                  <h3 class="font-display text-[24px] md:text-[28px] leading-[1.1] mb-4">
                    {p.title}
                  </h3>
                  {p.description && (
                    <p class="text-[15px] text-ink-soft leading-[1.7]">
                      {p.description}
                    </p>
                  )}
                </div>

                <!-- Image-pair column -->
                <div class:list={[
                  "md:col-span-7",
                  textRight ? "md:order-1 md:col-start-1" : "md:order-2",
                ]}>
                  <div class="grid grid-cols-2 gap-2 max-w-[460px] mx-auto md:mx-0">
                    <figure class="relative aspect-[3/4] rounded-xl overflow-hidden bg-bone shadow-[0_14px_36px_-14px_rgba(26,34,56,0.2)]">
                      <Image
                        src={p.antes}
                        alt={`Antes — ${p.title} · ${entry.data.patient} (con consentimiento; identidad anonimizada)`}
                        widths={[280, 420, 560]}
                        sizes="(min-width: 1024px) 220px, 45vw"
                        loading="lazy"
                        decoding="async"
                        format="webp"
                        quality={84}
                        class="w-full h-full object-cover"
                      />
                      <span class="absolute top-2 left-2 inline-flex items-center px-1.5 py-0.5 rounded-full bg-ink/85 text-bone text-[8.5px] font-medium tracking-[0.2em] uppercase backdrop-blur-md">
                        Antes
                      </span>
                    </figure>
                    <figure class="relative aspect-[3/4] rounded-xl overflow-hidden bg-bone shadow-[0_14px_36px_-14px_rgba(26,34,56,0.2)]">
                      <Image
                        src={p.despues}
                        alt={`Después — ${p.title} · ${entry.data.patient} (con consentimiento; identidad anonimizada)`}
                        widths={[280, 420, 560]}
                        sizes="(min-width: 1024px) 220px, 45vw"
                        loading="lazy"
                        decoding="async"
                        format="webp"
                        quality={84}
                        class="w-full h-full object-cover"
                      />
                      <span class="absolute top-2 left-2 inline-flex items-center gap-1 px-1.5 py-0.5 rounded-full bg-success/95 text-bone text-[8.5px] font-medium tracking-[0.2em] uppercase backdrop-blur-md">
                        <span class="w-1 h-1 rounded-full bg-champagne"></span>
                        Después
                      </span>
                    </figure>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <!-- ────────── LONG-FORM BODY ────────── -->
    <section class="py-20 md:py-24 bg-bone">
      <div class="container-page max-w-3xl">
        <Eyebrow class="mb-5">LECTURA CLÍNICA</Eyebrow>
        <article class="prose-mch text-[16px] text-ink-soft leading-[1.8]">
          <Content />
        </article>

        <div class="mt-14 pt-10 border-t border-line">
          <p class="text-[10px] text-slate-warm/80 leading-[1.6] italic">
            Cada caso es único. Los resultados mostrados corresponden a este paciente, su anatomía, su edad al inicio del tratamiento y su nivel de compromiso con las indicaciones clínicas. Una valoración individualizada es la única forma de saber si tu caso responde a un tratamiento similar.
          </p>
        </div>
      </div>
    </section>

    <!-- ────────── CTA ────────── -->
    <section class="py-20 md:py-24 bg-ink text-bone grain">
      <div class="container-page max-w-3xl text-center">
        <Eyebrow variant="light" class="mb-5">¿RECONOCES TU CASO?</Eyebrow>
        <h2 class="font-display text-[clamp(28px,4vw,44px)] leading-[1.1] text-bone mb-6">
          La valoración te dirá si <em class="italic-accent" style="color: var(--color-champagne);">aún estás a tiempo.</em>
        </h2>
        <p class="text-[16px] text-bone/70 leading-[1.65] mb-8 max-w-xl mx-auto">
          Si tu hijo o hija tiene mordida cruzada, mandíbula adelantada, o "perfil cóncavo" — el momento del diagnóstico hace toda la diferencia.
        </p>
        <div class="flex flex-wrap gap-3 justify-center">
          <Button href="/#contacto" variant="champagne" size="lg">
            Agendar valoración
          </Button>
          <Button href="/casos-destacados" variant="outline-light" size="lg" iconRight={false}>
            ← Ver más casos
          </Button>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .prose-mch :global(h2) {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(22px, 2.6vw, 30px);
    line-height: 1.2;
    color: var(--color-ink);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    letter-spacing: -0.01em;
  }
  .prose-mch :global(h3) {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 18px;
    color: var(--color-ink);
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
  }
  .prose-mch :global(p) { margin-bottom: 1rem; }
  .prose-mch :global(ul) { padding-left: 1.25rem; margin-bottom: 1.25rem; }
  .prose-mch :global(li) { list-style: disc; margin-bottom: 0.4rem; }
  .prose-mch :global(strong) { color: var(--color-ink); font-weight: 500; }
</style>
