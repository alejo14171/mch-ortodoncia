---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/nav/Header.astro";
import Footer from "../components/nav/Footer.astro";
import Hero from "../components/sections/Hero.astro";
import AuthorityStrip from "../components/sections/AuthorityStrip.astro";
import Retratamientos from "../components/sections/Retratamientos.astro";
import CasosSinCirugia from "../components/sections/CasosSinCirugia.astro";
import ReviewsCarousel from "../components/sections/ReviewsCarousel.astro";
import About from "../components/sections/About.astro";
import HealthFirst from "../components/sections/HealthFirst.astro";
import Credentials from "../components/sections/Credentials.astro";
import Services from "../components/sections/Services.astro";
import Process from "../components/sections/Process.astro";
import Office from "../components/sections/Office.astro";
import FAQ from "../components/sections/FAQ.astro";
import CTA from "../components/sections/CTA.astro";
import CookieBanner from "../components/ui/CookieBanner.astro";

const faqs = (await getCollection("faqs")).sort((a, b) => a.data.order - b.data.order);
const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);

// Strip frontmatter and convert collection items to JSON-LD friendly objects
const faqsForLd = faqs.map((f) => ({
  question: f.data.q,
  answer: (f.body || "").trim(),
}));
const servicesForLd = services.map((s) => ({
  name: s.data.title,
  description: s.data.desc,
}));

const title = "Dra. María Claudia Huertas · Ortodoncia y Retratamientos en Pereira";
const description =
  "Ortodoncista en Pereira con más de 25 años de experiencia. Especialista en retratamientos y ortopedia maxilar. Agenda tu valoración.";
---

<BaseLayout
  title={title}
  description={description}
  canonical="/"
  faqs={faqsForLd}
  services={servicesForLd}
  alternateEn="/en"
>
  <Header />
  <main>
    <Hero />
    <AuthorityStrip />
    <Retratamientos />
    <CasosSinCirugia />
    <ReviewsCarousel />
    <About />
    <HealthFirst />
    <Credentials />
    <Services />
    <Process />
    <Office />
    <FAQ />
    <CTA />
  </main>
  <Footer />
  <CookieBanner />
</BaseLayout>
