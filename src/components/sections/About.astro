---
import { Image } from "astro:assets";
import { ABOUT } from "../../content/site";
import Eyebrow from "../ui/Eyebrow.astro";
import Icon from "../icons/Icon.astro";
import portraitCutout from "../../assets/doctora/portrait-cutout.png";
---

<section
  id="sobre"
  class="bg-bone-soft border-y border-line py-24 md:py-32 relative overflow-hidden"
>
  <div class="absolute inset-0 -z-10 opacity-50" aria-hidden="true">
    <div
      class="absolute top-1/4 -right-32 w-[40%] h-[60%] rounded-full blur-3xl"
      style="background: radial-gradient(circle, rgba(184,150,90,0.15), transparent 60%);"
    ></div>
    <div
      class="absolute bottom-0 -left-20 w-[35%] h-[50%] rounded-full blur-3xl opacity-60"
      style="background: radial-gradient(circle, rgba(232,213,200,0.45), transparent 60%);"
    ></div>
  </div>

  <div class="container-page">
    <div class="grid lg:grid-cols-[1fr_1.25fr] gap-12 lg:gap-20 items-center">
      <!-- Portrait composition (cutout, sin marco, flotando sobre el fondo) -->
      <div class="relative reveal">
        <div class="relative w-full max-w-[440px] mx-auto">
          <!-- Decorative dotted arc -->
          <svg
            viewBox="0 0 440 560"
            class="absolute inset-0 w-full h-full -z-10 opacity-55"
            fill="none"
            aria-hidden="true"
          >
            <circle cx="220" cy="280" r="200" stroke="rgba(184,150,90,0.4)" stroke-width="1" stroke-dasharray="2 6" />
          </svg>
          <!-- Soft pedestal glow -->
          <div
            class="absolute inset-x-4 inset-y-8 -z-10 rounded-[2rem]"
            style="background: radial-gradient(ellipse at 50% 50%, rgba(232,213,200,0.55), rgba(251,248,243,0.3) 55%, transparent 80%);"
            aria-hidden="true"
          ></div>

          <Image
            src={portraitCutout}
            alt="Dra. María Claudia Huertas, retrato"
            widths={[440, 660, 880]}
            sizes="(min-width: 1024px) 440px, (min-width: 768px) 50vw, 90vw"
            loading="lazy"
            decoding="async"
            format="webp"
            quality={86}
            class="relative w-full h-auto object-contain drop-shadow-[0_25px_50px_rgba(26,34,56,0.22)]"
          />

          <!-- Floating credential -->
          <div
            class="absolute -bottom-2 -right-2 bg-ink text-bone rounded-xl px-4 py-3 shadow-[0_15px_40px_-12px_rgba(26,34,56,0.45)]"
          >
            <div class="text-[9px] tracking-[0.2em] text-champagne uppercase mb-1">Miembro</div>
            <div class="font-display text-[18px] leading-tight">SCO</div>
            <div class="text-[10px] text-bone/70 mt-0.5">Soc. Col. Ortodoncia</div>
          </div>
        </div>
      </div>

      <!-- Bio -->
      <div class="reveal reveal-delay-2">
        <Eyebrow class="mb-5">{ABOUT.eyebrow}</Eyebrow>
        <h2 class="font-display text-[clamp(32px,4.4vw,52px)] leading-[1.08]">
          {ABOUT.title}
        </h2>
        <p class="text-[14px] tracking-[0.04em] text-champagne-deep mt-3 mb-8">
          {ABOUT.subtitle}
        </p>

        <div class="space-y-4 text-[16px] text-ink-soft leading-[1.75] mb-8">
          {ABOUT.paragraphs.map((p) => <p>{p}</p>)}
        </div>

        <blockquote class="relative pl-6 border-l-2 border-champagne">
          <p class="font-display italic text-[20px] md:text-[22px] leading-[1.5] text-ink">
            "{ABOUT.quote}"
          </p>
          <footer class="text-[12px] tracking-[0.15em] text-slate-warm uppercase mt-3">
            Dra. María Claudia Huertas
          </footer>
        </blockquote>
      </div>
    </div>
  </div>
</section>
