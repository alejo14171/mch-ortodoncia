---
import { getCollection } from "astro:content";
import Eyebrow from "../ui/Eyebrow.astro";
import Icon from "../icons/Icon.astro";

const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
---

<section id="tratamientos" class="py-24 md:py-32">
  <div class="container-page">
    <header class="max-w-2xl mb-16 reveal">
      <Eyebrow class="mb-5">TRATAMIENTOS</Eyebrow>
      <h2 class="font-display text-[clamp(32px,4.6vw,56px)] leading-[1.08]">
        Cada plan se diseña <em class="italic-accent">para tu caso.</em>
      </h2>
      <p class="text-[17px] text-ink-soft leading-[1.65] mt-6 max-w-[58ch]">
        No hay tratamientos genéricos. Después del diagnóstico clínico completo, recibes una propuesta diseñada específicamente para tu boca.
      </p>
    </header>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5 lg:gap-6">
      {services.map((s, i) => (
        <article
          class={`group relative bg-bone-soft border border-line/80 rounded-card p-7 md:p-8 transition-all duration-500 hover:border-champagne/50 hover:-translate-y-1 hover:shadow-[0_18px_50px_-16px_rgba(26,34,56,0.18)] reveal reveal-delay-${(i % 4) + 1}`}
        >
          <div class="flex items-start justify-between mb-6">
            <div class="w-12 h-12 rounded-xl bg-champagne/12 border border-champagne/25 flex items-center justify-center text-champagne-deep group-hover:bg-champagne/20 group-hover:scale-105 transition-transform duration-500">
              <Icon name={s.data.icon} size={24} strokeWidth={1.5} />
            </div>
            <span class="text-[10px] tracking-[0.18em] font-medium text-slate-warm/70 uppercase">
              0{s.data.order}
            </span>
          </div>
          <h3 class="font-display text-[22px] md:text-[24px] mb-3 leading-tight">
            {s.data.title}
          </h3>
          <p class="text-[14px] text-ink-soft leading-[1.65] mb-5">
            {s.data.desc}
          </p>
          {s.body && (
            <p class="text-[13px] text-slate-warm leading-[1.65] pt-4 border-t border-line/70 hidden md:block">
              {s.body.trim()}
            </p>
          )}
          <div class="flex items-center gap-2 mt-5 pt-4 border-t border-line/50 text-[12px] text-champagne-deep">
            <Icon name="clock" size={13} strokeWidth={1.6} />
            <span>{s.data.duration}</span>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
