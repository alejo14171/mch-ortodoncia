---
// Carrusel de reseñas — auto-scroll + drag (mouse + touch).
//
// Implementación: contenedor con overflow-x:auto (touch swipe nativo) +
// handler de pointer events para click-drag con mouse. Auto-scroll por
// requestAnimationFrame que incrementa scrollLeft 1px/frame. Loop infinito
// duplicando las tarjetas y restando scrollWidth/2 al cruzar el medio.
//
// Pausa: cuando arrastras, cuando estás encima con el cursor, o cuando
// el usuario prefiere reduced-motion (en ese caso queda como scroll manual).
//
// Reseñas reales, publicadas con consentimiento informado de cada paciente
// o representante legal (Ley 1581 de 2012).
import Eyebrow from "../ui/Eyebrow.astro";

type Review = {
  initials: string;
  name: string;
  treatment: string;
  city: string;
  quote: string;
  rating: 4 | 5;
  palette: string;
};

const reviews: Review[] = [
  {
    initials: "NA",
    name: "Natalia Arias",
    treatment: "Retratamiento · evitó cirugía mandibular",
    city: "Pereira",
    quote:
      "Retomé mi ortodoncia con la Doctora Huertas después de un procedimiento fallido que me dejó con más problemas en mis dientes. Después de tres años de tratamiento puedo dar fe de su profesionalismo y entrega: logró devolverme la confianza y me evitó una cirugía de mandíbula casi inevitable. Estoy segura que puede con cualquier caso difícil. Quedé muy agradecida y feliz con mis resultados.",
    rating: 5,
    palette: "bg-champagne/20 text-champagne-deep",
  },
  {
    initials: "AG",
    name: "Alejandro Gómez",
    treatment: "Brackets metálicos · 14 años · 2 años de tratamiento",
    city: "Pereira",
    quote:
      "Empecé con la Dra. Huertas a los 14 años. Pasé dos años con brackets, pero lo que recuerdo más no son los alambres: son las conversaciones. Cada control era una explicación de qué estaba pasando con mi mordida y por qué. Años después entendí que no solo me organizó los dientes, me cambió la forma de verme en el espejo. La ortodoncia, cuando se hace bien, trabaja sobre la persona también.",
    rating: 5,
    palette: "bg-champagne-deep/15 text-ink",
  },
  {
    initials: "LJ",
    name: "Luisa Jaramillo",
    treatment: "Ortodoncia adulta · evitó cirugía maxilofacial",
    city: "Pereira",
    quote:
      "Fui a varios consultorios y me dijeron que necesitaba cirugía maxilofacial, lo cual me tenía muy preocupada. La Doctora Huertas evaluó mi caso y logramos corregir mis dientes solo con ortodoncia, sin necesidad de hacer cirugía. El resultado quedó súper natural y estoy muy contenta con el cambio y con el trato que recibí durante todo el proceso.",
    rating: 5,
    palette: "bg-clay/40 text-ink",
  },
  {
    initials: "AG",
    name: "Alan García",
    treatment: "Brackets metálicos · 13 años · 2 años de tratamiento",
    city: "Pereira",
    quote:
      "Hice mi tratamiento con la Doctora Huertas durante casi dos años. Lo que más me sorprendió fue que nunca sentí que era 'el paciente de las 4 de la tarde'. Se acordaba de cómo iba en el colegio, me explicaba con calma qué hacía cada ajuste, y nunca me dejó con dudas. El resultado quedó tan natural que hoy nadie pregunta si tuve brackets, asumen que mis dientes siempre fueron así. Esa, para mí, es la mejor señal de un trabajo bien hecho.",
    rating: 5,
    palette: "bg-clay/30 text-ink",
  },
  {
    initials: "CO",
    name: "Cielo Milena Osorio",
    treatment: "Ortodoncia pediátrica · madre de paciente",
    city: "Pereira",
    quote:
      "Siempre me ha parecido excelente profesional y persona. No le llevaría los dientes de mi princesa a nadie más. Muchos éxitos y mil bendiciones.",
    rating: 5,
    palette: "bg-bone-soft text-champagne-deep",
  },
  {
    initials: "NG",
    name: "Natalia García",
    treatment: "Brackets · 18 años · 2 años de tratamiento",
    city: "Pereira",
    quote:
      "Llegué un poco insegura, no estaba convencida de pasar dos años con brackets a mi edad. Lo que me convenció fue la primera valoración: por primera vez alguien me explicó qué tenía mi mordida en vez de pasar directo a la cotización. Salí del tratamiento con los dientes alineados, sí, pero también con una confianza al sonreír que antes no tenía. Hoy lo veo claro: la ortodoncia bien hecha trabaja sobre la persona, no solo sobre los dientes.",
    rating: 5,
    palette: "bg-champagne/25 text-champagne-deep",
  },
];

// Duplicamos para que el loop sea sin costuras al hacer wrap del scrollLeft.
const looped = [...reviews, ...reviews];
---

<section
  id="reviews"
  class="relative py-20 md:py-28 bg-bone overflow-hidden"
  aria-labelledby="reviews-heading"
>
  <div class="absolute inset-0 -z-10 opacity-50" aria-hidden="true">
    <div
      class="absolute top-1/4 -right-32 w-[40%] h-[60%] rounded-full blur-3xl"
      style="background: radial-gradient(circle, rgba(184,150,90,0.12), transparent 60%);"
    ></div>
  </div>

  <div class="container-page">
    <header class="max-w-2xl mb-10 md:mb-14 reveal">
      <div class="flex flex-wrap items-center gap-3 mb-5">
        <Eyebrow>VOCES DE PACIENTES</Eyebrow>
      </div>
      <h2
        id="reviews-heading"
        class="font-display text-[clamp(30px,4.4vw,52px)] leading-[1.08]"
      >
        Quienes ya pasaron por <em class="italic-accent">este consultorio.</em>
      </h2>
    </header>
  </div>

  <!-- Carousel: scroll container, full-bleed -->
  <div
    id="reviews-scroller"
    class="reviews-scroller reveal"
    role="region"
    aria-label="Carrusel de reseñas, arrastra para navegar"
    tabindex="0"
  >
    <div class="reviews-track">
      {looped.map((r, i) => (
        <article
          class="reviews-card"
          aria-hidden={i >= reviews.length ? "true" : "false"}
        >
          <div class="flex items-start gap-4 mb-4">
            <span
              class:list={[
                "flex-shrink-0 w-12 h-12 rounded-full flex items-center justify-center font-display text-[15px] font-medium tracking-tight select-none",
                r.palette,
              ]}
              aria-hidden="true"
            >
              {r.initials}
            </span>
            <div class="flex-1 min-w-0">
              <div class="font-display text-[15px] text-ink leading-tight">
                {r.name}
              </div>
              <div class="text-[11px] text-slate-warm tracking-wide mt-0.5">
                {r.treatment} · {r.city}
              </div>
            </div>
            <div class="flex-shrink-0 flex gap-0.5" aria-label={`Calificación ${r.rating} de 5`}>
              {Array.from({ length: 5 }).map((_, k) => (
                <svg
                  width="12"
                  height="12"
                  viewBox="0 0 24 24"
                  fill={k < r.rating ? "currentColor" : "none"}
                  stroke="currentColor"
                  stroke-width="1.5"
                  class={k < r.rating ? "text-champagne-deep" : "text-champagne-deep/30"}
                  aria-hidden="true"
                >
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26" />
                </svg>
              ))}
            </div>
          </div>
          <p class="text-[14px] leading-[1.65] text-ink-soft select-none">
            "{r.quote}"
          </p>
        </article>
      ))}
    </div>
  </div>

  <p class="container-page text-[11px] text-slate-warm/80 mt-8 max-w-2xl reveal">
    <strong>Nota:</strong> Cada reseña publicada en esta sección cuenta con consentimiento informado del paciente o su representante legal, conforme a la Ley 1581 de 2012.
  </p>
</section>

<style>
  .reviews-scroller {
    /* Native horizontal scroll: handles touch swipe out of the box.
       JS layer adds: auto-scroll, mouse-drag, infinite loop. */
    overflow-x: auto;
    overflow-y: hidden;
    scroll-behavior: auto; /* JS controls scroll, no smooth interfering */
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none; /* Firefox */
    cursor: grab;
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent 0,
      #000 6%,
      #000 94%,
      transparent 100%
    );
            mask-image: linear-gradient(
      90deg,
      transparent 0,
      #000 6%,
      #000 94%,
      transparent 100%
    );
    padding-block: 0.5rem;
  }
  .reviews-scroller::-webkit-scrollbar { display: none; }
  .reviews-scroller.is-dragging { cursor: grabbing; }
  .reviews-scroller.is-dragging .reviews-card { pointer-events: none; }

  .reviews-track {
    display: flex;
    gap: 1.25rem;
    width: max-content;
    padding-inline: 1.5rem; /* edge breathing room */
  }

  .reviews-card {
    flex-shrink: 0;
    width: 340px;
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: 1rem;
    padding: 1.5rem;
    box-shadow: 0 14px 36px -18px rgba(26, 34, 56, 0.18);
    /* avoid native drag on the card itself */
    user-select: none;
    -webkit-user-drag: none;
  }
  .reviews-card * { -webkit-user-drag: none; }
</style>

<script is:inline>
  (function () {
    var scroller = document.getElementById("reviews-scroller");
    if (!scroller) return;
    var track = scroller.querySelector(".reviews-track");
    if (!track) return;

    var reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // Compute the loop midpoint: the cards are duplicated, so half the
    // track width corresponds to one full set. Crossing that boundary
    // means we can subtract half to land on the visually identical spot
    // without the user noticing.
    function halfWidth() {
      // Use track.scrollWidth / 2 since the children are perfectly mirrored.
      return track.scrollWidth / 2;
    }

    // Start scrollLeft at 0 (beginning of first set).
    scroller.scrollLeft = 0;

    // ── Auto-scroll loop ────────────────────────────────────────────────
    var SPEED_PX_PER_FRAME = 0.6; // ~36px/s at 60fps; tuned to read comfortably
    var rafId = null;
    var paused = false;

    function tick() {
      if (!paused) {
        scroller.scrollLeft += SPEED_PX_PER_FRAME;
        var h = halfWidth();
        if (h > 0 && scroller.scrollLeft >= h) {
          // Seamless wrap: jump back by half the track width.
          scroller.scrollLeft -= h;
        }
      }
      rafId = requestAnimationFrame(tick);
    }

    function startAuto() {
      if (reduced) return; // user prefers no motion → leave it manual
      if (rafId == null) rafId = requestAnimationFrame(tick);
    }
    function stopAuto() {
      if (rafId != null) {
        cancelAnimationFrame(rafId);
        rafId = null;
      }
    }

    // ── Hover pause (desktop) ──────────────────────────────────────────
    scroller.addEventListener("mouseenter", function () { paused = true; });
    scroller.addEventListener("mouseleave", function () { paused = false; });

    // ── Drag with mouse / pointer (works for touch too, but touch already
    //    scrolls natively, so we let it pass through on coarse pointers) ──
    var isDown = false;
    var startX = 0;
    var startScroll = 0;
    var resumeTimeout = null;

    scroller.addEventListener("pointerdown", function (e) {
      // Only intercept primary button (mouse left, touch, pen).
      if (e.button !== 0 && e.pointerType === "mouse") return;
      // Let touch use native momentum scrolling; only hijack mouse/pen.
      if (e.pointerType === "touch") {
        paused = true;
        return;
      }
      isDown = true;
      startX = e.clientX;
      startScroll = scroller.scrollLeft;
      paused = true;
      scroller.classList.add("is-dragging");
      try { scroller.setPointerCapture(e.pointerId); } catch (_) {}
    });

    scroller.addEventListener("pointermove", function (e) {
      if (!isDown) return;
      e.preventDefault();
      var delta = e.clientX - startX;
      scroller.scrollLeft = startScroll - delta;
      // Maintain the seamless loop while dragging too.
      var h = halfWidth();
      if (h > 0) {
        if (scroller.scrollLeft >= h) {
          scroller.scrollLeft -= h;
          startScroll -= h;
        } else if (scroller.scrollLeft < 0) {
          scroller.scrollLeft += h;
          startScroll += h;
        }
      }
    });

    function endDrag() {
      if (isDown) {
        isDown = false;
        scroller.classList.remove("is-dragging");
      }
      if (resumeTimeout) clearTimeout(resumeTimeout);
      // Brief pause after drag so the user can read what they landed on.
      resumeTimeout = setTimeout(function () { paused = false; }, 1500);
    }

    scroller.addEventListener("pointerup", endDrag);
    scroller.addEventListener("pointercancel", endDrag);
    scroller.addEventListener("pointerleave", function () {
      if (isDown) endDrag();
    });

    // ── Keyboard accessibility ──────────────────────────────────────────
    scroller.addEventListener("keydown", function (e) {
      if (e.key === "ArrowLeft") {
        scroller.scrollLeft -= 200;
        paused = true;
        endDrag();
      } else if (e.key === "ArrowRight") {
        scroller.scrollLeft += 200;
        paused = true;
        endDrag();
      }
    });

    // ── Lazy-start: only animate when section enters the viewport so we
    //    don't burn rAF on a far-down section. ───────────────────────────
    var inView = false;
    var io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          inView = entry.isIntersecting;
          if (inView) startAuto();
          else stopAuto();
        });
      },
      { threshold: 0.1 }
    );
    io.observe(scroller);
  })();
</script>
