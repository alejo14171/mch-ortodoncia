---
import { PROCESS_STEPS } from "../../content/site";
import Eyebrow from "../ui/Eyebrow.astro";
---

<section class="py-24 md:py-32" aria-labelledby="proceso-heading">
  <div class="container-page">
    <header class="max-w-2xl mb-16 reveal">
      <Eyebrow class="mb-5">PROCESO</Eyebrow>
      <h2 id="proceso-heading" class="font-display text-[clamp(32px,4.6vw,56px)] leading-[1.08]">
        Cómo funciona tu <em class="italic-accent">primera consulta.</em>
      </h2>
    </header>

    <ol class="grid md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-10 relative">
      <!-- Connecting line -->
      <div
        class="hidden lg:block absolute top-[34px] left-[10%] right-[10%] h-px bg-champagne/30"
        aria-hidden="true"
      ></div>

      {PROCESS_STEPS.map((step, i) => (
        <li class={`relative reveal reveal-delay-${i + 1}`}>
          <div class="relative">
            <span class="font-display text-[64px] md:text-[72px] font-light leading-none text-champagne block">
              {step.n}
            </span>
            <span
              class="absolute top-2 -right-2 lg:top-2 lg:right-1/2 lg:translate-x-[60px] hidden lg:block w-3 h-3 rounded-full bg-champagne ring-4 ring-bone"
              aria-hidden="true"
            ></span>
          </div>
          <h3 class="font-display text-[20px] mt-3 mb-2 leading-tight">{step.title}</h3>
          <p class="text-[14px] text-ink-soft leading-[1.65]">{step.desc}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
