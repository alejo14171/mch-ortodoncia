---
import { getCollection } from "astro:content";
import Eyebrow from "../ui/Eyebrow.astro";
import Icon from "../icons/Icon.astro";

const cases = (await getCollection("cases")).sort((a, b) => a.data.order - b.data.order);

// Eager-import case schematics (always SVG) and patient portraits (real photos
// take priority over AI-generated SVG placeholders by extension order: png > jpg > webp > svg).
const illustrations = import.meta.glob<{ default: string }>("../../assets/casos/*.svg", {
  eager: true,
  query: "?url",
  import: "default",
});
const portraits = import.meta.glob<{ default: string }>(
  "../../assets/casos-fotos/*.{png,jpg,jpeg,webp,svg}",
  { eager: true, query: "?url", import: "default" }
);

function findUrl(map: Record<string, unknown>, needle: string): string {
  // Prefer raster (real photo) over SVG (AI placeholder) when both exist.
  const matches = Object.entries(map).filter(([k]) => k.includes(needle));
  if (matches.length === 0) return "";
  const priority = [".png", ".jpg", ".jpeg", ".webp", ".svg"];
  matches.sort(([a], [b]) => {
    const ai = priority.findIndex((ext) => a.endsWith(ext));
    const bi = priority.findIndex((ext) => b.endsWith(ext));
    return ai - bi;
  });
  return matches[0]![1] as string;
}

function isRealPhoto(url: string): boolean {
  return /\.(png|jpe?g|webp)(\?.*)?$/i.test(url);
}
---

<section
  id="casos"
  class="py-24 md:py-32 bg-bone-soft border-y border-line"
>
  <div class="container-page">
    <header class="max-w-2xl mb-12 reveal">
      <Eyebrow class="mb-5">CASOS</Eyebrow>
      <h2 class="font-display text-[clamp(32px,4.6vw,56px)] leading-[1.08]">
        Resultados que <em class="italic-accent">se quedan.</em>
      </h2>
      <p class="text-[16px] text-ink-soft leading-[1.65] mt-5 max-w-[58ch]">
        Cada tarjeta resume un caso real ilustrado de forma esquemática. Toca para ver el antes/después y los detalles del tratamiento.
      </p>
    </header>

    <!-- Disclaimer -->
    <div class="bg-white border border-line rounded-xl p-5 md:p-6 mb-10 max-w-4xl reveal">
      <div class="flex items-start gap-3">
        <span class="flex-shrink-0 w-6 h-6 rounded-full bg-champagne/15 border border-champagne/40 flex items-center justify-center text-[11px] text-champagne-deep font-semibold mt-0.5">
          i
        </span>
        <p class="text-[13px] text-ink-soft leading-[1.65]">
          <strong class="text-ink">Imágenes esquemáticas y retratos generados con IA</strong> con fines de presentación clínica. Cada caso es único; los resultados varían según diagnóstico, anatomía y compromiso del paciente. Las ilustraciones se actualizarán con casos reales bajo consentimiento informado.
        </p>
      </div>
    </div>

    <div class="grid md:grid-cols-2 gap-5">
      {cases.map((c, i) => {
        const illoUrl = findUrl(illustrations, c.data.file);
        const portraitUrl = findUrl(portraits, `caso-${String(c.data.order).padStart(2, "0")}-paciente`);
        const isReal = isRealPhoto(portraitUrl);
        return (
          <details
            class={`group/case bg-white border border-line rounded-card overflow-hidden transition-all duration-500 hover:shadow-[0_18px_50px_-16px_rgba(26,34,56,0.18)] reveal reveal-delay-${(i % 4) + 1}`}
          >
            <summary class="list-none cursor-pointer block">
              <!-- PEEK: top sliver of portrait + meta -->
              <div class="relative">
                <div
                  class="h-[160px] md:h-[180px] overflow-hidden relative group-open/case:h-[420px] transition-[height] duration-500 ease-out"
                >
                  <img
                    src={portraitUrl}
                    alt={
                      isReal
                        ? `Caso clínico real, ${c.data.title} (${c.data.patient})`
                        : `Retrato esquemático del paciente, ${c.data.patient}`
                    }
                    width="400"
                    height="480"
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover object-[center_30%] group-open/case:object-[center_top]"
                  />
                  {!isReal && (
                    <div class="absolute top-3 right-3 inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-ink/85 text-bone text-[10px] font-medium tracking-wider uppercase backdrop-blur-md">
                      <span class="w-1.5 h-1.5 rounded-full bg-champagne"></span>
                      Generado con IA
                    </div>
                  )}
                  {isReal && (
                    <div class="absolute top-3 right-3 inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-success/95 text-bone text-[10px] font-medium tracking-wider uppercase backdrop-blur-md">
                      <span class="w-1.5 h-1.5 rounded-full bg-champagne"></span>
                      Caso real
                    </div>
                  )}
                  <!-- Soft fade overlay at bottom for legibility -->
                  <div
                    class="absolute inset-x-0 bottom-0 h-24 pointer-events-none"
                    style="background: linear-gradient(180deg, transparent, rgba(255,255,255,0.95));"
                  ></div>
                </div>
              </div>

              <!-- Header bar -->
              <div class="px-6 pt-5 pb-5 flex items-start justify-between gap-4">
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-3 mb-1.5">
                    <span class="font-display text-[12px] tracking-[0.18em] text-champagne-deep uppercase">
                      Caso {String(c.data.order).padStart(2, "0")}
                    </span>
                    <span class="text-[11px] text-slate-warm">{c.data.subtitle}</span>
                  </div>
                  <h3 class="font-display text-[20px] md:text-[22px] leading-tight">{c.data.title}</h3>
                  <p class="text-[12px] text-slate-warm mt-1">{c.data.patient} · {c.data.duration}</p>
                </div>
                <span
                  class="flex-shrink-0 mt-1 w-9 h-9 rounded-full border border-champagne/40 text-champagne-deep flex items-center justify-center transition-transform duration-500 group-open/case:rotate-45 group-open/case:bg-champagne group-open/case:text-ink"
                  aria-hidden="true"
                >
                  <Icon name="plus" size={14} strokeWidth={2.2} />
                </span>
              </div>
            </summary>

            <!-- EXPANDED content -->
            <div class="px-6 pb-7 pt-2 border-t border-line/60">
              <!-- Schematic before/after (vertical stack) -->
              <figure class="mt-5">
                <figcaption class="text-[10px] tracking-[0.22em] uppercase text-slate-warm mb-2 px-2">
                  Esquema clínico
                </figcaption>
                <div class="bg-bone-soft rounded-lg p-3 border border-line/70 max-w-[360px] mx-auto">
                  <img
                    src={illoUrl}
                    alt={`Esquema del caso ${c.data.order}: ${c.data.title}, antes y después`}
                    width="400"
                    height="580"
                    loading="lazy"
                    decoding="async"
                    class="w-full h-auto"
                  />
                </div>
              </figure>

              <!-- Treatment details -->
              <dl class="grid grid-cols-2 gap-x-6 gap-y-3 mt-6 text-[13px]">
                <div>
                  <dt class="eyebrow text-[10px] mb-1">Tratamiento</dt>
                  <dd class="text-ink-soft leading-snug">{c.data.treatment}</dd>
                </div>
                <div>
                  <dt class="eyebrow text-[10px] mb-1">Duración</dt>
                  <dd class="text-ink-soft leading-snug">{c.data.duration}</dd>
                </div>
                <div class="col-span-2">
                  <dt class="eyebrow text-[10px] mb-1">Resultado</dt>
                  <dd class="text-ink-soft leading-snug">{c.data.outcome}</dd>
                </div>
              </dl>

              <!-- Per-card disclaimer -->
              <p class="text-[10px] text-slate-warm/70 leading-[1.55] mt-5 pt-4 border-t border-line/60 italic">
                Esquema de referencia clínica. Cada caso es único, los resultados varían según diagnóstico y compromiso del paciente.
              </p>
            </div>
          </details>
        );
      })}
    </div>
  </div>
</section>

<style>
  /* Hide native disclosure arrow on Webkit/Firefox */
  details > summary::-webkit-details-marker { display: none; }
  details > summary { list-style: none; }
</style>
