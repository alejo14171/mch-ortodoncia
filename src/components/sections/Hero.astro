---
import { Image } from "astro:assets";
import { HERO, SITE } from "../../content/site";
import Button from "../ui/Button.astro";
import Eyebrow from "../ui/Eyebrow.astro";
import portraitCutout from "../../assets/doctora/portrait-cutout.png";

const waUrl = `https://wa.me/${SITE.contact.whatsappDigits}?text=${encodeURIComponent("Hola Dra. Huertas, me gustaría agendar una valoración.")}`;
---

<section
  id="contenido"
  class="relative overflow-hidden pt-4 pb-14 md:pt-12 md:pb-24 lg:pt-20 lg:pb-32"
>
  <!-- Decorative background gradient (visible on every breakpoint) -->
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <div
      class="absolute -top-32 -right-24 w-[70%] h-[60%] rounded-full opacity-70 blur-3xl"
      style="background: radial-gradient(circle at center, rgba(184,150,90,0.22), transparent 65%);"
    ></div>
    <div
      class="absolute top-1/3 -left-20 w-[55%] h-[55%] rounded-full opacity-55 blur-3xl"
      style="background: radial-gradient(circle at center, rgba(232,213,200,0.55), transparent 65%);"
    ></div>
  </div>

  <div class="container-page">
    <!-- ============================================
         MOBILE LAYOUT (< lg)
         Cutout sits in the first viewport above
         the copy. Visible without scrolling.
         ============================================ -->
    <div class="lg:hidden">
      <!-- Eyebrow -->
      <div class="reveal">
        <Eyebrow class="mb-3">{HERO.eyebrow}</Eyebrow>
      </div>

      <!-- Cutout stage: gradient pedestal + portrait floating on top -->
      <div class="relative reveal -mx-4 sm:mx-0 mb-4">
        <!-- Soft pedestal behind the cutout -->
        <div
          class="absolute inset-x-6 sm:inset-x-12 bottom-2 top-8 rounded-[2.5rem] -z-10"
          style="background: radial-gradient(ellipse at 50% 40%, rgba(232,213,200,0.55), rgba(251,248,243,0.4) 55%, transparent 80%);"
          aria-hidden="true"
        ></div>
        <!-- Gold arc accent -->
        <svg
          viewBox="0 0 400 200"
          class="absolute inset-x-0 top-6 w-full h-32 -z-10 opacity-60"
          fill="none"
          aria-hidden="true"
        >
          <path d="M 40 160 Q 200 20 360 160" stroke="rgba(184,150,90,0.35)" stroke-width="1" stroke-dasharray="2 4" />
        </svg>

        <Image
          src={portraitCutout}
          alt="Dra. María Claudia Huertas, ortodoncista en Pereira con más de 25 años de experiencia."
          widths={[320, 480, 640]}
          sizes="(min-width: 640px) 480px, 100vw"
          loading="eager"
          decoding="sync"
          fetchpriority="high"
          format="webp"
          quality={88}
          class="relative w-auto h-[42vh] min-h-[280px] max-h-[420px] mx-auto object-contain drop-shadow-[0_18px_30px_rgba(26,34,56,0.18)]"
        />

        <!-- Floating "Desde 2000" chip -->
        <div
          class="absolute left-4 sm:left-8 bottom-4 bg-bone-soft/95 border border-champagne/30 rounded-2xl px-4 py-2.5 shadow-[0_15px_40px_-12px_rgba(26,34,56,0.25)] backdrop-blur-sm"
        >
          <div class="text-[9px] tracking-[0.18em] font-medium text-champagne-deep uppercase">
            Pereira · desde
          </div>
          <div class="font-display text-[24px] leading-none text-ink">
            2000
          </div>
        </div>
      </div>

      <!-- Headline -->
      <h1 class="font-display text-[clamp(34px,8.5vw,52px)] leading-[1.04] mb-5 reveal reveal-delay-1">
        {HERO.titlePre}
        <em class="italic-accent">{HERO.titleEmphasis}</em>
        <br />
        {HERO.titlePost}
      </h1>

      <p class="text-[16px] leading-[1.6] text-ink-soft mb-7 reveal reveal-delay-2">
        {HERO.subtitle}
      </p>

      <div data-hero-mobile-ctas class="flex flex-wrap gap-3 mb-4 reveal reveal-delay-3">
        <Button href="#contacto" variant="primary" size="lg">
          {HERO.ctaPrimary}
        </Button>
        <Button href={waUrl} variant="whatsapp" size="lg" external iconRight={false}>
          {HERO.ctaSecondary}
        </Button>
      </div>

      <p class="text-[13px] text-slate-warm flex items-center gap-2 reveal reveal-delay-3">
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-success" aria-hidden="true"></span>
        {HERO.microcopy}
      </p>

      <!-- Trust micro-row, grid de 3 para que cada stat ocupe el mismo ancho -->
      <div class="mt-10 pt-7 border-t border-line/70 grid grid-cols-3 gap-3 reveal">
        <div>
          <div class="font-display text-xl text-champagne-deep leading-none">+25</div>
          <div class="text-[11px] text-ink-soft tracking-wide mt-1.5">años de experiencia</div>
        </div>
        <div>
          <div class="font-display text-xl text-champagne-deep leading-none">+5000</div>
          <div class="text-[11px] text-ink-soft tracking-wide mt-1.5">pacientes atendidos<sup class="text-[9px] ml-0.5 opacity-60">*</sup></div>
        </div>
        <div>
          <div class="flex items-center gap-1.5">
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-champagne-deep -translate-y-px"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="9" />
              <path d="M3 12h18M12 3a13 13 0 0 1 0 18M12 3a13 13 0 0 0 0 18" />
            </svg>
            <span class="font-display text-xl text-champagne-deep leading-none">2</span>
          </div>
          <div class="text-[11px] text-ink-soft tracking-wide mt-1.5">idiomas <span class="opacity-70">ES · EN</span></div>
        </div>
      </div>
    </div>

    <!-- ============================================
         DESKTOP LAYOUT (lg+)
         Two-column. Cutout floats on the right
         over the gradient, no framed card.
         ============================================ -->
    <div class="hidden lg:grid lg:grid-cols-[1.15fr_1fr] gap-20 items-center">
      <!-- Left: copy -->
      <div class="reveal">
        <Eyebrow class="mb-7">{HERO.eyebrow}</Eyebrow>

        <h1 class="font-display text-[clamp(40px,6vw,76px)] leading-[1.04] mb-7 max-w-[14ch]">
          {HERO.titlePre}
          <em class="italic-accent">{HERO.titleEmphasis}</em>
          <br />
          {HERO.titlePost}
        </h1>

        <p class="text-[19px] leading-[1.6] text-ink-soft max-w-[52ch] mb-9">
          {HERO.subtitle}
        </p>

        <div class="flex flex-wrap gap-3 mb-5">
          <Button href="#contacto" variant="primary" size="lg">
            {HERO.ctaPrimary}
          </Button>
          <Button href={waUrl} variant="whatsapp" size="lg" external iconRight={false}>
            {HERO.ctaSecondary}
          </Button>
        </div>

        <p class="text-[13px] text-slate-warm flex items-center gap-2">
          <span class="inline-block w-1.5 h-1.5 rounded-full bg-success" aria-hidden="true"></span>
          {HERO.microcopy}
        </p>

        <!-- Trust micro-row -->
        <div class="mt-12 pt-8 border-t border-line/70 flex flex-wrap gap-x-10 gap-y-4">
          <div class="flex items-baseline gap-2">
            <span class="font-display text-2xl text-champagne-deep leading-none">+25</span>
            <span class="text-[13px] text-ink-soft tracking-wide">años de experiencia</span>
          </div>
          <div class="flex items-baseline gap-2">
            <span class="font-display text-2xl text-champagne-deep leading-none">+5000</span>
            <span class="text-[13px] text-ink-soft tracking-wide">pacientes atendidos<sup class="text-[9px] ml-0.5 opacity-60">*</sup></span>
          </div>
          <div class="flex items-baseline gap-2">
            <span class="inline-flex items-center gap-1.5">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="text-champagne-deep -translate-y-px"
                aria-hidden="true"
              >
                <circle cx="12" cy="12" r="9" />
                <path d="M3 12h18M12 3a13 13 0 0 1 0 18M12 3a13 13 0 0 0 0 18" />
              </svg>
              <span class="font-display text-2xl text-champagne-deep leading-none">2</span>
            </span>
            <span class="text-[13px] text-ink-soft tracking-wide">idiomas <span class="opacity-70">ES · EN</span></span>
          </div>
        </div>
      </div>

      <!-- Right: cutout floating on gradient -->
      <div class="relative reveal reveal-delay-2">
        <div class="relative w-full max-w-[520px] mx-auto">
          <!-- Soft pedestal glow -->
          <div
            class="absolute inset-x-0 -inset-y-6 -z-10"
            style="background: radial-gradient(ellipse at 50% 50%, rgba(232,213,200,0.6), rgba(251,248,243,0.3) 55%, transparent 80%);"
            aria-hidden="true"
          ></div>
          <!-- Curved gold arc behind portrait -->
          <svg
            viewBox="0 0 500 600"
            class="absolute inset-0 w-full h-full -z-10 opacity-50"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M 60 540 Q 60 200 250 100 Q 440 200 440 540"
              stroke="rgba(184,150,90,0.45)"
              stroke-width="1.2"
              stroke-dasharray="2 6"
            />
          </svg>

          <Image
            src={portraitCutout}
            alt="Dra. María Claudia Huertas, ortodoncista en Pereira con más de 25 años de experiencia."
            widths={[480, 720, 960]}
            sizes="520px"
            loading="eager"
            decoding="sync"
            fetchpriority="high"
            format="webp"
            quality={88}
            class="relative w-full h-auto object-contain drop-shadow-[0_30px_50px_rgba(26,34,56,0.22)]"
          />

          <!-- Floating credential card -->
          <div
            class="absolute -left-6 bottom-12 bg-bone-soft/95 border border-champagne/30 rounded-2xl px-5 py-4 shadow-[0_20px_50px_-15px_rgba(26,34,56,0.25)] backdrop-blur-sm"
          >
            <div class="text-[10px] tracking-[0.18em] font-medium text-champagne-deep uppercase mb-1">
              Desde
            </div>
            <div class="font-display text-[34px] leading-none text-ink">
              2000
            </div>
            <div class="text-[11px] text-slate-warm mt-1 max-w-[10ch] leading-tight">
              Atendiendo en Pereira
            </div>
          </div>

        </div>
      </div>
    </div>

    <!-- footnote disclaimer -->
    <p class="text-[10px] text-slate-warm/70 mt-10 md:mt-12 max-w-[60ch]">
      <sup>*</sup> Cifra estimada acumulada desde el inicio de la práctica clínica.
    </p>
  </div>
</section>
