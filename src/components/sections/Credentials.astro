---
// Credentials strip with university + SCO badges.
// UN and El Bosque use official logos from Wikimedia Commons (CC BY-SA 4.0).
// SCO uses a typographic shield as fallback — their site doesn't expose a
// public SVG; drop a file at src/assets/logos-institucionales/sco.svg and
// uncomment the import to swap.
import { Image } from "astro:assets";
import unLogo from "../../assets/logos-institucionales/un.svg";
import elBosqueLogo from "../../assets/logos-institucionales/el-bosque.svg";
---

<section
  class="py-12 md:py-16 bg-bone-soft border-y border-line"
  aria-label="Credenciales académicas"
>
  <div class="container-page">
    <div class="grid md:grid-cols-3 gap-6 md:gap-10 items-center">
      <!-- Universidad Nacional -->
      <div class="flex items-center gap-4 group reveal">
        <div class="flex-shrink-0 w-16 h-16 flex items-center justify-center">
          <Image
            src={unLogo}
            alt="Escudo de la Universidad Nacional de Colombia"
            widths={[64, 96, 128]}
            sizes="64px"
            format="webp"
            quality={92}
            class="w-full h-full object-contain"
          />
        </div>
        <div class="min-w-0">
          <div class="text-[10px] tracking-[0.18em] text-champagne-deep uppercase font-medium mb-0.5">
            Pregrado · Odontología
          </div>
          <div class="font-display text-[16px] leading-tight text-ink">
            Universidad Nacional<br/>
            <span class="text-[12px] text-slate-warm font-sans tracking-wide">de Colombia</span>
          </div>
        </div>
      </div>

      <!-- Universidad El Bosque -->
      <div class="flex items-center gap-4 group reveal reveal-delay-1">
        <div class="flex-shrink-0 w-16 h-16 flex items-center justify-center">
          <Image
            src={elBosqueLogo}
            alt="Logo de la Universidad El Bosque"
            widths={[64, 96, 128]}
            sizes="64px"
            format="webp"
            quality={92}
            class="w-full h-full object-contain"
          />
        </div>
        <div class="min-w-0">
          <div class="text-[10px] tracking-[0.18em] text-champagne-deep uppercase font-medium mb-0.5">
            Especialización · Ortodoncia
          </div>
          <div class="font-display text-[16px] leading-tight text-ink">
            Universidad El Bosque<br/>
            <span class="text-[12px] text-slate-warm font-sans tracking-wide">Bogotá, Colombia</span>
          </div>
        </div>
      </div>

      <!-- SCO (typographic shield until official SVG is provided) -->
      <div class="flex items-center gap-4 group reveal reveal-delay-2">
        <div class="flex-shrink-0 w-16 h-16 rounded-full border-2 border-champagne-deep bg-bone flex items-center justify-center font-display text-[16px] font-medium tracking-tight text-champagne-deep shadow-[inset_0_0_0_3px_#FBF8F3]">
          SCO
        </div>
        <div class="min-w-0">
          <div class="text-[10px] tracking-[0.18em] text-champagne-deep uppercase font-medium mb-0.5">
            Miembro activa
          </div>
          <div class="font-display text-[16px] leading-tight text-ink">
            Sociedad Colombiana<br/>
            <span class="text-[12px] text-slate-warm font-sans tracking-wide">de Ortodoncia</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
