---
// Credentials strip with university + SCO badges.
// Uses typographic shields (no third-party logos to avoid trademark issues —
// replace with official SVG logos once licensing is confirmed with each institution).
---

<section
  class="py-12 md:py-16 bg-bone-soft border-y border-line"
  aria-label="Credenciales académicas"
>
  <div class="container-page">
    <div class="grid md:grid-cols-3 gap-6 md:gap-10 items-center">
      <!-- Universidad Nacional -->
      <div class="flex items-center gap-4 group reveal">
        <div class="flex-shrink-0 w-14 h-14 rounded-full border-2 border-ink/85 bg-bone flex items-center justify-center font-display text-[18px] font-medium tracking-tight text-ink shadow-[inset_0_0_0_3px_#FBF8F3]">
          UN
        </div>
        <div class="min-w-0">
          <div class="text-[10px] tracking-[0.18em] text-champagne-deep uppercase font-medium mb-0.5">
            Pregrado · Odontología
          </div>
          <div class="font-display text-[16px] leading-tight text-ink">
            Universidad Nacional<br/>
            <span class="text-[12px] text-slate-warm font-sans tracking-wide">de Colombia</span>
          </div>
        </div>
      </div>

      <!-- Universidad El Bosque -->
      <div class="flex items-center gap-4 group reveal reveal-delay-1">
        <div class="flex-shrink-0 w-14 h-14 rounded-full border-2 border-success bg-bone flex items-center justify-center font-display text-[18px] font-medium tracking-tight text-success shadow-[inset_0_0_0_3px_#FBF8F3]">
          EB
        </div>
        <div class="min-w-0">
          <div class="text-[10px] tracking-[0.18em] text-champagne-deep uppercase font-medium mb-0.5">
            Especialización · Ortodoncia
          </div>
          <div class="font-display text-[16px] leading-tight text-ink">
            Universidad El Bosque<br/>
            <span class="text-[12px] text-slate-warm font-sans tracking-wide">Bogotá, Colombia</span>
          </div>
        </div>
      </div>

      <!-- SCO -->
      <div class="flex items-center gap-4 group reveal reveal-delay-2">
        <div class="flex-shrink-0 w-14 h-14 rounded-full border-2 border-champagne-deep bg-bone flex items-center justify-center font-display text-[15px] font-medium tracking-tight text-champagne-deep shadow-[inset_0_0_0_3px_#FBF8F3]">
          SCO
        </div>
        <div class="min-w-0">
          <div class="text-[10px] tracking-[0.18em] text-champagne-deep uppercase font-medium mb-0.5">
            Miembro activa
          </div>
          <div class="font-display text-[16px] leading-tight text-ink">
            Sociedad Colombiana<br/>
            <span class="text-[12px] text-slate-warm font-sans tracking-wide">de Ortodoncia</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
