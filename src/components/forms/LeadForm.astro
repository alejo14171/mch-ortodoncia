---
import { SITE } from "../../content/site";
import Button from "../ui/Button.astro";
import Icon from "../icons/Icon.astro";

// On submit we redirect to wa.me with the form data prellenada en el mensaje.
// No backend involved — la doctora recibe el lead directo en su WhatsApp.
const whatsappDigits = SITE.contact.whatsappDigits;
---

<form
  id="lead-form"
  novalidate
  data-wa-phone={whatsappDigits}
  class="grid grid-cols-1 md:grid-cols-2 gap-5"
>
  <div class="md:col-span-2">
    <label for="lf-name" class="block text-[13px] font-medium text-ink mb-2">
      Nombre completo <span class="text-rosewood">*</span>
    </label>
    <input
      id="lf-name"
      name="name"
      type="text"
      required
      autocomplete="name"
      minlength="2"
      maxlength="120"
      class="w-full px-4 py-3 rounded-lg border border-line bg-bone-soft text-ink placeholder:text-slate-warm/70 focus:border-champagne focus:ring-2 focus:ring-champagne/20 outline-none transition-all"
      placeholder="Como aparece en tu cédula"
    />
  </div>

  <div>
    <label for="lf-whatsapp" class="block text-[13px] font-medium text-ink mb-2">
      WhatsApp <span class="text-rosewood">*</span>
    </label>
    <input
      id="lf-whatsapp"
      name="whatsapp"
      type="tel"
      required
      autocomplete="tel"
      pattern="^(\+?57)?\s?3\d{2}\s?\d{3}\s?\d{4}$"
      class="w-full px-4 py-3 rounded-lg border border-line bg-bone-soft text-ink placeholder:text-slate-warm/70 focus:border-champagne focus:ring-2 focus:ring-champagne/20 outline-none transition-all"
      placeholder="+57 314 000 0000"
    />
  </div>

  <div>
    <label for="lf-email" class="block text-[13px] font-medium text-ink mb-2">
      Correo electrónico <span class="text-rosewood">*</span>
    </label>
    <input
      id="lf-email"
      name="email"
      type="email"
      required
      autocomplete="email"
      class="w-full px-4 py-3 rounded-lg border border-line bg-bone-soft text-ink placeholder:text-slate-warm/70 focus:border-champagne focus:ring-2 focus:ring-champagne/20 outline-none transition-all"
      placeholder="tu@correo.com"
    />
  </div>

  <div>
    <label for="lf-for" class="block text-[13px] font-medium text-ink mb-2">
      ¿Para quién es la consulta?
    </label>
    <select
      id="lf-for"
      name="forWhom"
      class="w-full px-4 py-3 rounded-lg border border-line bg-bone-soft text-ink focus:border-champagne focus:ring-2 focus:ring-champagne/20 outline-none transition-all"
    >
      <option value="self">Para mí</option>
      <option value="child">Mi hijo/a</option>
      <option value="family">Otro familiar</option>
    </select>
  </div>

  <div>
    <label for="lf-age" class="block text-[13px] font-medium text-ink mb-2">
      Edad del paciente <span class="text-rosewood">*</span>
    </label>
    <input
      id="lf-age"
      name="patientAge"
      type="number"
      required
      min="3"
      max="100"
      class="w-full px-4 py-3 rounded-lg border border-line bg-bone-soft text-ink placeholder:text-slate-warm/70 focus:border-champagne focus:ring-2 focus:ring-champagne/20 outline-none transition-all"
      placeholder="Ej: 32"
    />
  </div>

  <div class="md:col-span-2">
    <label for="lf-interest" class="block text-[13px] font-medium text-ink mb-2">
      Tipo de tratamiento de interés
    </label>
    <select
      id="lf-interest"
      name="interest"
      class="w-full px-4 py-3 rounded-lg border border-line bg-bone-soft text-ink focus:border-champagne focus:ring-2 focus:ring-champagne/20 outline-none transition-all"
    >
      <option value="not-sure">No estoy seguro/a</option>
      <option value="brackets">Brackets</option>
      <option value="retratamiento">Retratamiento</option>
      <option value="ortopedia">Ortopedia maxilar (niños)</option>
      <option value="prequirurgica">Ortodoncia prequirúrgica</option>
      <option value="other">Otro</option>
    </select>
  </div>

  <div class="md:col-span-2">
    <label for="lf-reason" class="block text-[13px] font-medium text-ink mb-2">
      Cuéntame tu caso <span class="text-slate-warm font-normal">(opcional)</span>
    </label>
    <textarea
      id="lf-reason"
      name="reason"
      rows="4"
      maxlength="300"
      class="w-full px-4 py-3 rounded-lg border border-line bg-bone-soft text-ink placeholder:text-slate-warm/70 focus:border-champagne focus:ring-2 focus:ring-champagne/20 outline-none transition-all resize-none"
      placeholder="¿Qué te trae al consultorio? Si tuviste tratamiento previo, cuéntame brevemente."
    ></textarea>
    <div class="text-[11px] text-slate-warm mt-1 text-right">
      <span id="lf-reason-count">0</span>/300
    </div>
  </div>

  <div class="md:col-span-2 flex items-start gap-3 pt-2">
    <input
      id="lf-consent"
      name="consent"
      type="checkbox"
      required
      class="mt-1 flex-shrink-0 w-4 h-4 accent-champagne-deep cursor-pointer"
    />
    <label for="lf-consent" class="text-[12px] text-ink-soft leading-[1.55] cursor-pointer">
      Autorizo el tratamiento de mis datos personales para el agendamiento de la consulta y comunicación, según la
      <a href="/politica-privacidad" class="underline hover:text-champagne-deep" target="_blank" rel="noopener">
        Política de Privacidad
      </a>
      (Ley 1581 de 2012). <span class="text-rosewood">*</span>
    </label>
  </div>

  <input type="hidden" name="hp" value="" tabindex="-1" autocomplete="off" />

  <div class="md:col-span-2 flex flex-wrap items-center gap-4 pt-2">
    <Button type="submit" variant="whatsapp" size="lg">
      Enviar por WhatsApp
    </Button>
    <p class="text-[12px] text-slate-warm flex items-center gap-2">
      <Icon name="clock" size={13} strokeWidth={1.6} />
      Respondo personalmente en menos de 24 h hábiles.
    </p>
  </div>

  <div
    id="lf-error"
    class="md:col-span-2 hidden bg-rosewood/10 border border-rosewood/30 text-rosewood rounded-xl p-5"
    role="alert"
  >
    <p class="font-medium">No pudimos abrir WhatsApp.</p>
    <p class="text-[14px] text-ink-soft mt-1">
      Escríbeme directo por WhatsApp tocando el botón verde al inicio de esta sección.
    </p>
  </div>
</form>

<script is:inline>
  (function () {
    var form = document.getElementById("lead-form");
    if (!form) return;
    var errorBox = document.getElementById("lf-error");
    var counter = document.getElementById("lf-reason-count");
    var reason = document.getElementById("lf-reason");

    if (reason && counter) {
      reason.addEventListener("input", function () {
        counter.textContent = String(reason.value.length);
      });
    }

    var FOR_WHOM = {
      self: "Para mí",
      child: "Para mi hijo/a",
      family: "Para otro familiar",
    };
    var INTEREST = {
      "not-sure": "Aún no sé qué tratamiento necesito",
      brackets: "Brackets",
      retratamiento: "Retratamiento",
      ortopedia: "Ortopedia maxilar (niños)",
      prequirurgica: "Ortodoncia prequirúrgica",
      other: "Otro",
    };

    form.addEventListener("submit", function (e) {
      e.preventDefault();
      errorBox.classList.add("hidden");

      var fd = new FormData(form);
      // Honeypot
      if (fd.get("hp")) return;

      // Native HTML5 validation: shows tooltips on required/pattern fields.
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      var phone = form.getAttribute("data-wa-phone");
      if (!phone) {
        errorBox.classList.remove("hidden");
        return;
      }

      var name = (fd.get("name") || "").toString().trim();
      var whatsapp = (fd.get("whatsapp") || "").toString().trim();
      var email = (fd.get("email") || "").toString().trim();
      var forWhom = FOR_WHOM[fd.get("forWhom")] || "Para mí";
      var age = (fd.get("patientAge") || "").toString().trim();
      var interest = INTEREST[fd.get("interest")] || "Aún no sé qué tratamiento necesito";
      var reasonText = (fd.get("reason") || "").toString().trim();

      var lines = [
        "Hola Dra. Huertas, me gustaría agendar una valoración.",
        "",
        "👤 Nombre: " + name,
        "📱 WhatsApp: " + whatsapp,
        "📧 Email: " + email,
        "👥 " + forWhom,
        "🎂 Edad: " + age,
        "🦷 Interés: " + interest,
      ];
      if (reasonText) {
        lines.push("", "📝 Motivo:", reasonText);
      }

      var url = "https://wa.me/" + phone + "?text=" + encodeURIComponent(lines.join("\n"));

      if (window.plausible) {
        try { window.plausible("Lead Submitted"); } catch (_) {}
      }

      var submitBtn = form.querySelector("button[type=submit]");
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = "Abriendo WhatsApp…";
      }

      // Mobile: opens native WhatsApp app. Desktop: opens WA Web in same tab.
      window.location.href = url;
    });
  })();
</script>
