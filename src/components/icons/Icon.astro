---
interface Props {
  name: string;
  class?: string;
  size?: number;
  strokeWidth?: number;
}
const { name, class: cls = "", size = 24, strokeWidth = 1.4 } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={[cls]}
  aria-hidden="true"
  role="img"
>
  {name === "calendar" && (
    <>
      <rect x="3" y="5" width="18" height="16" rx="2" />
      <path d="M3 9h18M8 3v4M16 3v4" />
    </>
  )}
  {name === "graduation-cap" && (
    <>
      <path d="M2 9l10-5 10 5-10 5L2 9z" />
      <path d="M6 11v5c0 1.5 3 3 6 3s6-1.5 6-3v-5" />
    </>
  )}
  {name === "badge" && (
    <>
      <circle cx="12" cy="9" r="6" />
      <path d="M9 14l-1.5 7L12 18l4.5 3L15 14" />
    </>
  )}
  {name === "globe" && (
    <>
      <circle cx="12" cy="12" r="9" />
      <path d="M3 12h18M12 3a13 13 0 0 1 0 18M12 3a13 13 0 0 0 0 18" />
    </>
  )}
  {name === "refresh-tooth" && (
    <>
      <path d="M8 3a4 4 0 0 0-4 4v3c0 4 1.5 8 3 11l1-5h4l1 5c1.5-3 3-7 3-11V7a4 4 0 0 0-4-4 6 6 0 0 0-4 0z" />
      <path d="M16 14l2-2-2-2M22 12a4 4 0 0 1-4 4" />
    </>
  )}
  {name === "expand-arch" && (
    <>
      <path d="M4 14c0-5 4-9 8-9s8 4 8 9" />
      <path d="M2 14h2M20 14h2M7 14v3M12 14v3M17 14v3" />
    </>
  )}
  {name === "brackets" && (
    <>
      <line x1="3" y1="12" x2="21" y2="12" />
      <rect x="4" y="9" width="3" height="6" rx="0.6" />
      <rect x="10.5" y="9" width="3" height="6" rx="0.6" />
      <rect x="17" y="9" width="3" height="6" rx="0.6" />
    </>
  )}
  {name === "brackets-clear" && (
    <>
      <line x1="3" y1="12" x2="21" y2="12" />
      <circle cx="6" cy="12" r="2" />
      <circle cx="12" cy="12" r="2" />
      <circle cx="18" cy="12" r="2" />
    </>
  )}
  {name === "aligner" && (
    <>
      <path d="M5 9c0-1 7-2 7-2s7 1 7 2v6c0 1-7 2-7 2s-7-1-7-2V9z" />
      <path d="M5 12h14" stroke-dasharray="2 2" />
    </>
  )}
  {name === "tooth-bone" && (
    <>
      <path d="M8 3a4 4 0 0 0-4 4v3c0 4 1.5 8 3 11l1-5h4l1 5c1.5-3 3-7 3-11V7a4 4 0 0 0-4-4 6 6 0 0 0-4 0z" />
      <circle cx="19" cy="6" r="2" />
      <circle cx="19" cy="12" r="2" />
    </>
  )}
  {name === "phone" && (
    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
  )}
  {name === "mail" && (
    <>
      <rect x="2" y="4" width="20" height="16" rx="2" />
      <path d="m22 6-10 7L2 6" />
    </>
  )}
  {name === "map-pin" && (
    <>
      <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
      <circle cx="12" cy="10" r="3" />
    </>
  )}
  {name === "clock" && (
    <>
      <circle cx="12" cy="12" r="9" />
      <path d="M12 7v5l3 2" />
    </>
  )}
  {name === "check" && <path d="M5 13l4 4L19 7" />}
  {name === "arrow-right" && (
    <>
      <line x1="5" y1="12" x2="19" y2="12" />
      <polyline points="12 5 19 12 12 19" />
    </>
  )}
  {name === "external" && (
    <>
      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
      <polyline points="15 3 21 3 21 9" />
      <line x1="10" y1="14" x2="21" y2="3" />
    </>
  )}
  {name === "menu" && (
    <>
      <line x1="4" y1="7" x2="20" y2="7" />
      <line x1="4" y1="12" x2="20" y2="12" />
      <line x1="4" y1="17" x2="20" y2="17" />
    </>
  )}
  {name === "x" && (
    <>
      <line x1="6" y1="6" x2="18" y2="18" />
      <line x1="18" y1="6" x2="6" y2="18" />
    </>
  )}
  {name === "plus" && (
    <>
      <line x1="12" y1="5" x2="12" y2="19" />
      <line x1="5" y1="12" x2="19" y2="12" />
    </>
  )}
  {name === "sparkle" && (
    <path d="M12 3l1.7 5.3L19 10l-5.3 1.7L12 17l-1.7-5.3L5 10l5.3-1.7L12 3z" fill="currentColor" />
  )}
  {name === "quote" && (
    <path d="M7 8c-2 0-3 1.5-3 3.5S5 15 7 15c0 2-1 3-3 4 0 0 5-1 6-5V8H7zm10 0c-2 0-3 1.5-3 3.5s1 3.5 3 3.5c0 2-1 3-3 4 0 0 5-1 6-5V8h-3z" fill="currentColor" stroke="none" />
  )}
</svg>
