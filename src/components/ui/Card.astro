---
interface Props {
  variant?: "soft" | "dark" | "outline";
  hover?: boolean;
  class?: string;
}
const { variant = "soft", hover = true, class: cls = "" } = Astro.props;

const variants = {
  soft:
    "bg-bone-soft border border-line/80 text-ink",
  dark:
    "bg-white/[0.04] border border-champagne/20 text-bone backdrop-blur-sm",
  outline:
    "bg-transparent border border-line text-ink",
};
const hoverCls = hover
  ? variant === "dark"
    ? "transition-all duration-500 hover:border-champagne/50 hover:bg-white/[0.06] hover:-translate-y-1"
    : "transition-all duration-500 hover:-translate-y-1 hover:shadow-[0_18px_50px_-16px_rgba(26,34,56,0.18)] hover:border-champagne/40"
  : "";
---

<article class:list={["rounded-card p-7 md:p-8", variants[variant], hoverCls, cls]}>
  <slot />
</article>
